[org.gnome.settings-daemon.plugins.power]
# Linux 7 may report stale AC state after unplug; keep idle sleep on AC.
sleep-inactive-ac-type='suspend'
sleep-inactive-ac-timeout=900
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=900

# Avoid critical auto-suspend warnings waking Phosh and resetting its idle watch.
# Notifications remain available; screen wake by notification is disabled.
[sm.puri.phosh.notifications]
wakeup-screen-triggers=[]

# Operator-requested persistent battery percentage.
[org.gnome.desktop.interface]
show-battery-percentage=true
