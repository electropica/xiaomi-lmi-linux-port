+static gboolean
+lmi_sleep_blocked (GVariant *result)
+{
+        GVariantIter *iter = NULL;
+        const gchar *what, *who, *why, *mode;
+        guint32 uid, pid;
+        gboolean blocked = FALSE;
+
+        if (result == NULL || !g_variant_is_of_type (result, G_VARIANT_TYPE ("(a(ssssuu))"))) {
+                blocked = TRUE; /* fail closed when logind is unavailable */
+        } else {
+                g_variant_get (result, "(a(ssssuu))", &iter);
+                while (g_variant_iter_loop (iter, "(&s&s&s&suu)", &what, &who, &why, &mode, &uid, &pid)) {
+                        g_auto(GStrv) kinds = g_strsplit (what, ":", -1);
+                        if ((g_str_equal (mode, "block") || g_str_equal (mode, "block-weak")) &&
+                            g_strv_contains ((const gchar * const *) kinds, "sleep")) {
+                                blocked = TRUE;
+                                break;
+                        }
+                }
+                g_variant_iter_free (iter);
+        }
+        return blocked;
+}
+
+static void
+lmi_retry_inhibitors_done (GObject *source, GAsyncResult *res, gpointer user_data)
+{
+        GsdPowerManager *manager = user_data;
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) result = NULL;
+        gboolean blocked;
+
+        result = g_dbus_proxy_call_finish (G_DBUS_PROXY (source), res, &error);
+        blocked = lmi_sleep_blocked (result);
+        if (!g_cancellable_is_cancelled (manager->cancellable) &&
+            manager->session_is_active && manager->current_idle_mode != GSD_POWER_IDLE_MODE_NORMAL) {
+                if (blocked || manager->lmi_suspend_pending) {
+                        if (manager->lmi_retry_id == 0) {
+                                manager->lmi_retry_delay = MIN (MAX (manager->lmi_retry_delay, 60) * 2, 300);
+                                manager->lmi_retry_id = g_timeout_add_seconds (manager->lmi_retry_delay, lmi_retry_cb, manager);
+                                g_message ("LMI_SLEEP_RETRY deferred delay=%u", manager->lmi_retry_delay);
+                        }
+                } else {
+                        /* Re-arm the standard idle watch; it checks idle time,
+                         * configured action and session inhibitors itself. */
+                        g_message ("LMI_SLEEP_RETRY rechecking idle policy");
+                        idle_configure (manager);
+                }
+        }
+        g_object_unref (manager);
+}
+
+static gboolean
+lmi_retry_cb (gpointer user_data)
+{
+        GsdPowerManager *manager = user_data;
+        manager->lmi_retry_id = 0;
+        if (!manager->session_is_active || manager->current_idle_mode == GSD_POWER_IDLE_MODE_NORMAL ||
+            manager->logind_proxy == NULL)
+                return G_SOURCE_REMOVE;
+        g_dbus_proxy_call (manager->logind_proxy, "ListInhibitors", NULL,
+                           G_DBUS_CALL_FLAGS_NONE, 10000, manager->cancellable,
+                           lmi_retry_inhibitors_done, g_object_ref (manager));
+        return G_SOURCE_REMOVE;
+}
