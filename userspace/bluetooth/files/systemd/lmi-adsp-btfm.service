[Unit]
Description=Perform the single guarded lmi ADSP boot and validate BTFM SLIM
Requires=lmi-pd-mapper.service lmi-adsp-firmware-prepare.service qrtr-ns.service
After=lmi-pd-mapper.service lmi-adsp-firmware-prepare.service qrtr-ns.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lmi-adsp-btfm-start
RemainAfterExit=yes
Restart=no

[Install]
WantedBy=multi-user.target
