+/* Give the application deck the height it needs.
+ *
+ * The deck is an HdyDeck whose natural height is the sum of the minimum
+ * heights of the search row and of the application list.  GTK gives an
+ * expanding child at most its natural height and leaves the rest of the drawer
+ * empty, so as long as the preview strip takes half of the drawer, the band
+ * between the window previews and the search bar stayed empty and the
+ * application list was squeezed into a fifth of the drawer.
+ *
+ * An explicit height request removes that dead band: the deck then takes
+ * exactly what the strip leaves over and the list fills the drawer.
+ */
+void
+phosh_app_grid_set_deck_height (PhoshAppGrid *self,
+                                 int          height)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  g_return_if_fail (PHOSH_IS_APP_GRID (self));
+
+  gtk_widget_set_size_request (GTK_WIDGET (priv->deck), -1, MAX (height, 0));
+}
