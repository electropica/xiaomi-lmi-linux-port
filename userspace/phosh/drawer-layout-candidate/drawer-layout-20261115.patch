+/* Height of the application deck, i.e. of everything the drawer shows below
+ * the preview strip.
+ *
+ * The strip is measured with the usable area of the screen, but the strip box
+ * is taller than the carousel it holds: the carousel keeps a bottom margin.
+ * The deck then gets what is left of the usable area, minus the chrome the
+ * drawer takes for itself. */
+static int
+lmi_drawer_deck_height (int strip_height)
+{
+  int usable = 0;
+  int height;
+
+  phosh_shell_get_usable_area (phosh_shell_get_default (), NULL, NULL,
+                                NULL, &usable);
+  if (usable <= 0)
+    return 0;
+
+  height = usable - strip_height - LMI_DRAWER_CHROME_HEIGHT;
+
+  return MAX (height, 0);
+}
