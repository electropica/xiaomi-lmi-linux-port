-/* Decide if a search without results has to be dropped.
- *
- * Called when the drawer transition ended and after every applied query, so
- * that a query whose debounce was still pending when the drawer was closed
- * is judged on its own results and not on the ones of the previous query. */
-static void
-lmi_maybe_clear_search (PhoshAppGrid *self)
-{
-  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
-  const char *current;
-
-  /* No drawer close was confirmed. */
-  if (!priv->lmi_close_pending)
-    return;
-
-  /* The entry was edited after the close: that is a new search, an older
-   * close must not drop it.  The delayed "search-changed" of a change made
-   * before the close does not touch the generation and keeps the close. */
-  if (priv->lmi_input_generation != priv->lmi_close_generation)
-    return;
-
-  current = priv->lmi_entry_text ? priv->lmi_entry_text : "";
-
-  /* No search to drop. */
-  if (current[0] == '\0')
-    return;
-
-  /* The model does not hold the text of the entry yet, wait for the
-   * debounce. */
-  if (!lmi_model_matches_entry (self))
-    return;
-
-  /* The search has results, keep it. */
-  if (g_list_model_get_n_items (G_LIST_MODEL (priv->model)) != 0)
-    return;
-
-  lmi_clear_search (self);
-}
