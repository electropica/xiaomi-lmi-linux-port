-/* Remember the text of the entry and count the real input changes.
- *
- * GtkSearchEntry delays "search-changed" by about 150 ms, so the raw text of
- * the entry is the only immediate information about what the user typed.  The
- * generation tells a change made before the drawer was closed from the
- * delayed signal of that very change. */
-static void
-lmi_set_entry_text (PhoshAppGrid *self, const char *text)
-{
-  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
-  char *folded = g_utf8_casefold (text ? text : "", -1);
-
-  if (g_strcmp0 (folded, priv->lmi_entry_text) == 0) {
-    g_free (folded);
-    return;
-  }
-
-  g_free (priv->lmi_entry_text);
-  priv->lmi_entry_text = folded;
-  priv->lmi_input_generation++;
-}
