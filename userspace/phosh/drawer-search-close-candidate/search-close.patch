-static gboolean
-lmi_model_matches_entry (PhoshAppGrid *self)
-{
-  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
-  const char *current = priv->lmi_entry_text ? priv->lmi_entry_text : "";
