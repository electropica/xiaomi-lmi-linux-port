+/* The preview strip must not change the height of the app list.
+ *
+ * The strip holds the running-activity carousel, so its height follows the
+ * number of open windows. Without a reservation, every miniature that appears
+ * or disappears moves the whole app list, and the icon under a finger is then
+ * a different icon than the one that was drawn. Reserving the height of a
+ * populated strip keeps the app list at a constant position and a constant
+ * viewport, whatever happens to be running. */
+static void
+lmi_previews_update_reserved_height (PhoshOverview *self)
+{
+  PhoshOverviewPrivate *priv = phosh_overview_get_instance_private (self);
+  GtkWidget *previews_box;
+
+  g_return_if_fail (PHOSH_IS_OVERVIEW (self));
+
+  previews_box = GTK_WIDGET (gtk_widget_get_template_child (
+    GTK_WIDGET (priv->app_grid), PHOSH_TYPE_APP_GRID, "lmi_drawer_previews"));
+  if (previews_box == NULL)
+    return;
+
+  if (priv->carousel_running_activities != NULL &&
+      gtk_widget_get_visible (priv->carousel_running_activities)) {
+    gint height = 0;
+
+    gtk_widget_get_preferred_height (priv->carousel_running_activities, NULL, &height);
+    if (height > 0)
+      priv->lmi_previews_reserved_height = height;
+  }
+
+  gtk_widget_set_size_request (previews_box, -1, priv->lmi_previews_reserved_height);
+}
+
