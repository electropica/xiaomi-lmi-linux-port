+/* The drawer deck must not own a swipe gesture while the app list is visible.
+ *
+ * libhandy drives a deck swipe from a capture-phase drag gesture
+ * (hdy-swipe-tracker.c). A drag that starts on a GtkButton - and every app
+ * icon is one - is force-dragged by that tracker, and 16 px into the drag the
+ * tracker claims the touch sequence (GTK_EVENT_SEQUENCE_CLAIMED) and grabs
+ * the deck. The GtkScrolledWindow underneath then never receives the touch:
+ * the list neither scrolls nor hands the release to the icon that was
+ * pressed, and the page moves instead.
+ *
+ * The deck therefore owns no gesture while the applications page is visible.
+ * The home page has no scroller, so its upward swipe stays enabled and still
+ * opens the app list. Going back to the home page is done with the back
+ * button, not with a gesture over the list. */
+static void
+lmi_drawer_update_swipe_allowance (PhoshAppGrid *self)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  gboolean on_home = g_strcmp0 (
+    hdy_deck_get_visible_child_name (HDY_DECK (priv->lmi_favorites_drawer)),
+    "home") == 0;
+
+  hdy_deck_set_can_swipe_forward (HDY_DECK (priv->lmi_favorites_drawer), on_home);
+  hdy_deck_set_can_swipe_back (HDY_DECK (priv->lmi_favorites_drawer), FALSE);
+}
+
+
+static void
+on_lmi_back_clicked (PhoshAppGrid *self,
+                     GtkButton   *button)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+
+  hdy_deck_set_visible_child_name (HDY_DECK (priv->lmi_favorites_drawer), "home");
 }
 
 
