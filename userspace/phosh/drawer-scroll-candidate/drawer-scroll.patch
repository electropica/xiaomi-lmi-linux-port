+/* The app list consumes downward scrolling until its first row is reached. */
+static void
+lmi_drawer_update_swipe_back (PhoshAppGrid *self, GtkAdjustment *adjustment)
+{
+  PhoshAppGridPrivate *priv = phosh_app_grid_get_instance_private (self);
+  gboolean at_top = gtk_adjustment_get_value (adjustment) <=
+                    gtk_adjustment_get_lower (adjustment);
+
+  hdy_deck_set_can_swipe_back (HDY_DECK (priv->lmi_favorites_drawer), at_top);
+}
+
