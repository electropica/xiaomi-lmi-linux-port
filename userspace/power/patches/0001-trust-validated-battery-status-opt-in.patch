+	/* Opt-in for drivers whose current sign does not follow this heuristic.
+	 * This preserves the reported status; it does not invert the current or
+	 * infer a discharge state. The property must only be set for hardware
+	 * whose status has been validated across a physical charging transition.
+	 */
+	if (!g_udev_device_get_property_as_boolean (native, "UPOWER_TRUST_BATTERY_STATUS") &&
+	    values.state != UP_DEVICE_STATE_FULLY_CHARGED &&
 	    g_udev_device_get_sysfs_attr_as_double_uncached (native, "current_now") < 0.0)
 		values.state = UP_DEVICE_STATE_DISCHARGING;
 
