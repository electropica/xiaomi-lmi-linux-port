+    def test_battery_negative_current_status_opt_in(self):
+        """Opt-in preserves status without changing the default heuristic.
+
+        Positive-current discharge is a synthetic contract check, not evidence
+        that any particular downstream device reports that sign when unplugged.
+        """
+        bat0 = self.testbed.add_device(
+            "power_supply", "BAT0", None,
+            ["type", "Battery", "scope", "System", "present", "1",
+             "status", "Charging", "capacity", "50",
+             "charge_full", "4000000", "charge_full_design", "4000000",
+             "charge_now", "2000000", "voltage_now", "4000000",
+             "current_now", "-250000"],
+            [],
+        )
+        cases = (
+            # No rule/property: retain the existing mainline behavior.
+            (None, "Charging", "-250000", UP_DEVICE_STATE_DISCHARGING),
+            ("0", "Charging", "-250000", UP_DEVICE_STATE_DISCHARGING),
+            ("1", "Charging", "-250000", UP_DEVICE_STATE_CHARGING),
+            ("1", "Discharging", "250000", UP_DEVICE_STATE_DISCHARGING),
+            ("1", "Discharging", "-250000", UP_DEVICE_STATE_DISCHARGING),
+            ("0", "Full", "-250000", UP_DEVICE_STATE_FULLY_CHARGED),
+            ("1", "Full", "-250000", UP_DEVICE_STATE_FULLY_CHARGED),
+        )
+        for opt_in, status, current, expected in cases:
+            with self.subTest(opt_in=opt_in, status=status, current=current):
+                if opt_in is not None:
+                    self.testbed.set_property(bat0, "UPOWER_TRUST_BATTERY_STATUS", opt_in)
+                self.testbed.set_attribute(bat0, "status", status)
+                self.testbed.set_attribute(bat0, "current_now", current)
+                # 100% must not suppress the legacy sign override by itself.
+                self.testbed.set_attribute(bat0, "capacity", "100" if status in ("Charging", "Full") else "50")
+                self.start_daemon()
+                try:
+                    devices = self.proxy.EnumerateDevices()
+                    self.assertEqual(len(devices), 1)
+                    self.assertEqual(self.get_dbus_dev_property(devices[0], "State"), expected)
+                finally:
+                    self.stop_daemon()
+
