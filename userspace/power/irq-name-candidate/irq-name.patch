@@ -569,0 +570,18 @@
+/* Linux IRQ numbers can change across boots. Accept exactly one
+ * numeric IRQ and its complete event name; combined/unknown reasons reject. */
+static gboolean
+lmi_resume_reason_has_name (const char *reason, const char *name)
+{
+  const char *p = reason;
+
+  if (p == NULL || !g_ascii_isdigit (*p))
+    return FALSE;
+  while (g_ascii_isdigit (*p))
+    p++;
+  if (*p != ' ')
+    return FALSE;
+  while (*p == ' ')
+    p++;
+  return g_strcmp0 (p, name) == 0;
+}
