+
+static void
+lmi_suspend_done_cb (GObject      *source_object,
+                     GAsyncResult *res,
+                     gpointer      user_data)
+{
+        GsdPowerManager *manager = user_data;
+        g_autoptr(GError) error = NULL;
+        g_autoptr(GVariant) result = NULL;
+
+        result = g_dbus_proxy_call_finish (G_DBUS_PROXY (source_object), res, &error);
+        manager->lmi_suspend_pending = FALSE;
+
+        if (result != NULL)
+                return;
+
+        /* The suspend request was refused. current_idle_mode is still
+         * SLEEP, and the "less idle" guard in idle_set_mode() then
+         * swallows every later sleep request, so the device would never
+         * sleep again until real user activity. Restore the mode we came
+         * from without running its side effects: the panel must stay
+         * exactly as it is. */
+        g_warning ("Error calling suspend action: %s; restoring idle mode %s so a later sleep request is not swallowed",
+                   error != NULL ? error->message : "unknown error",
+                   idle_mode_to_string (manager->lmi_idle_mode_before_sleep));
+
+        if (manager->current_idle_mode == GSD_POWER_IDLE_MODE_SLEEP)
+                manager->current_idle_mode = manager->lmi_idle_mode_before_sleep;
 }
 
