+static gboolean
+lmi_sleep_total (gint64 *total)
+{
+        struct timespec now;
+        if (clock_gettime (CLOCK_BOOTTIME, &now) != 0)
+                return FALSE;
+        *total = (gint64) now.tv_sec * G_USEC_PER_SEC + now.tv_nsec / 1000
+                 - g_get_monotonic_time ();
+        return TRUE;
+}
+
+/* IRQ 441 is accepted only with a fresh, noncritical discharging reading.
+ * Missing data, low/empty events and combined IRQ reasons fail open. */
+static gboolean
+lmi_quiet_reason_allowed (const char *reason)
+{
+  g_autofree char *capacity = NULL;
+  g_autofree char *status = NULL;
+  char *end = NULL;
+  guint64 level;
+
+  if (g_strcmp0 (reason, "438 msoc-delta") == 0)
+    return TRUE;
+  if (g_strcmp0 (reason, "441 msoc-high") != 0)
+    return FALSE;
+  if (!g_file_get_contents ("/sys/class/power_supply/battery/capacity",
+                            &capacity, NULL, NULL) ||
+      !g_file_get_contents ("/sys/class/power_supply/battery/status",
+                            &status, NULL, NULL))
+    return FALSE;
+  g_strstrip (capacity);
+  if (!g_ascii_isdigit (capacity[0]) ||
+      g_strcmp0 (g_strstrip (status), "Discharging") != 0)
+    return FALSE;
+  level = g_ascii_strtoull (capacity, &end, 10);
+  return end != capacity && *end == '\0' && level >= 30 && level <= 100;
+}
+
+static gboolean
+lmi_quiet_resume_matches (gboolean peer_ready, gboolean blank_before,
+                          gboolean blank_now, gboolean activity_seen,
+                          gboolean was_sleep, gboolean before_valid,
+                          gboolean after_valid, gint64 before, gint64 after,
+                          const char *reason, const char *usb)
+{
+        return peer_ready && blank_before && blank_now && !activity_seen
+               && was_sleep && before_valid && after_valid
+               && after > before && after - before > 50000
+               && lmi_quiet_reason_allowed (reason)
+               && g_strcmp0 (usb, "0") == 0;
+}
+
+static gboolean
+lmi_quiet_gauge_resume (GsdPowerManager *manager)
+{
+        gint64 after = 0;
+        gboolean after_valid = lmi_sleep_total (&after);
+        g_autofree char *reason = NULL;
+        g_autofree char *usb = NULL;
+        if (!g_file_get_contents ("/sys/kernel/wakeup_reasons/last_resume_reason",
+                                  &reason, NULL, NULL) ||
+            !g_file_get_contents ("/sys/class/power_supply/usb/online",
+                                  &usb, NULL, NULL))
+                return FALSE;
+        return lmi_quiet_resume_matches (
+                lmi_phosh_filter_peer_ready (), manager->lmi_screen_blank_before,
+                manager->screensaver_active, manager->lmi_resume_activity_seen,
+                manager->current_idle_mode == GSD_POWER_IDLE_MODE_SLEEP,
+                manager->lmi_sleep_before_valid, after_valid,
+                manager->lmi_sleep_before, after,
+                g_strstrip (reason), g_strstrip (usb));
+}
