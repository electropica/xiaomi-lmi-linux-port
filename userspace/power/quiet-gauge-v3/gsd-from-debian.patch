+/* Optional companion to a shell-owned resume policy. This is deliberately
+ * default-off and must not suppress display requests when the active shell
+ * cannot be identified. Ordinary activity and brightness paths are unchanged.
+ */
+static gboolean
+lmi_phosh_filter_peer_ready (void)
+{
+        GsdDisplayConfig *display_config;
+        g_autofree char *owner = NULL;
+        g_autofree char *owner_after = NULL;
+        g_autofree char *comm_path = NULL;
+        g_autofree char *comm = NULL;
+        g_autofree char *environment_path = NULL;
+        g_autofree char *environment = NULL;
+        gsize environment_size = 0;
+        gboolean peer_opted_in = FALSE;
+        g_autoptr (GVariant) reply = NULL;
+        g_autoptr (GVariant) owner_reply = NULL;
+        GDBusConnection *connection;
+        guint32 pid;
+
+        if (g_strcmp0 (g_getenv ("LMI_GSD_QUIET_GAUGE_RESUME"), "1") != 0)
+                return FALSE;
+
+        display_config = gnome_settings_bus_get_display_config_proxy ();
+        if (display_config == NULL || !G_IS_DBUS_PROXY (display_config) ||
+            g_strcmp0 (g_dbus_proxy_get_name (G_DBUS_PROXY (display_config)),
+                       "org.gnome.Mutter.DisplayConfig") != 0)
+                return FALSE;
+        connection = g_dbus_proxy_get_connection (G_DBUS_PROXY (display_config));
+        owner_reply = g_dbus_connection_call_sync (
+                connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                "org.freedesktop.DBus", "GetNameOwner",
+                g_variant_new ("(s)", "org.gnome.Mutter.DisplayConfig"),
+                G_VARIANT_TYPE ("(s)"), G_DBUS_CALL_FLAGS_NONE, 250, NULL, NULL);
+        if (owner_reply == NULL)
+                return FALSE;
+        g_variant_get (owner_reply, "(s)", &owner);
+        g_clear_pointer (&owner_reply, g_variant_unref);
+
+        reply = g_dbus_connection_call_sync (
+                connection,
+                "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                "org.freedesktop.DBus", "GetConnectionUnixProcessID",
+                g_variant_new ("(s)", owner), G_VARIANT_TYPE ("(u)"),
+                G_DBUS_CALL_FLAGS_NONE, 250, NULL, NULL);
+        if (reply == NULL)
+                return FALSE;
+        g_variant_get (reply, "(u)", &pid);
+        comm_path = g_strdup_printf ("/proc/%u/comm", pid);
+        if (!g_file_get_contents (comm_path, &comm, NULL, NULL) ||
+            g_strcmp0 (g_strstrip (comm), "phosh") != 0)
+                return FALSE;
+        environment_path = g_strdup_printf ("/proc/%u/environ", pid);
+        if (!g_file_get_contents (environment_path, &environment,
+                                  &environment_size, NULL))
+                return FALSE;
+        for (gsize pos = 0; pos < environment_size;) {
+                gsize remaining = environment_size - pos;
+                const char *end = memchr (environment + pos, '\0', remaining);
+                if (end == NULL)
+                        return FALSE;
+                if (g_strcmp0 (environment + pos,
+                               "LMI_PHOSH_GAUGE_WAKE_FILTER=1") == 0)
+                        peer_opted_in = TRUE;
+                pos += (end - (environment + pos)) + 1;
+        }
+        if (!peer_opted_in)
+                return FALSE;
+        owner_reply = g_dbus_connection_call_sync (
+                connection, "org.freedesktop.DBus", "/org/freedesktop/DBus",
+                "org.freedesktop.DBus", "GetNameOwner",
+                g_variant_new ("(s)", "org.gnome.Mutter.DisplayConfig"),
+                G_VARIANT_TYPE ("(s)"), G_DBUS_CALL_FLAGS_NONE, 250, NULL, NULL);
+        if (owner_reply == NULL)
+                return FALSE;
+        g_variant_get (owner_reply, "(s)", &owner_after);
+        return g_strcmp0 (owner, owner_after) == 0;
+}
