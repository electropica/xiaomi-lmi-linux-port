+typedef struct
+{
+    NautilusListBase *view;
+    GHashTable *selection;
+    NautilusViewItem *target;
+} TouchSelectionChange;
+
+static gboolean
+apply_touch_selection_change (gpointer user_data)
+{
+    TouchSelectionChange *change = user_data;
+    NautilusListBasePrivate *priv = nautilus_list_base_get_instance_private (change->view);
+    NautilusViewModel *model = nautilus_list_base_get_model (change->view);
+
+    if (priv->touch_selection_mode && model != NULL && change->target != NULL)
+    {
+        GtkSelectionModel *selection_model = GTK_SELECTION_MODEL (model);
+        g_autoptr (GtkBitset) desired = gtk_bitset_new_empty ();
+        g_autoptr (GtkBitset) update = NULL;
+        gboolean target_was_selected = g_hash_table_contains (change->selection,
+                                                               change->target);
+        guint n_items = g_list_model_get_n_items (G_LIST_MODEL (model));
+
+        for (guint position = 0; position < n_items; position++)
+        {
+            g_autoptr (NautilusViewItem) item = get_view_item (G_LIST_MODEL (model),
+                                                               position);
+            gboolean was_selected = g_hash_table_contains (change->selection, item);
+
+            if ((was_selected && item != change->target) ||
+                (!target_was_selected && item == change->target))
+            {
+                gtk_bitset_add (desired, position);
+            }
+        }
+
+        update = gtk_bitset_new_range (0, n_items);
+        gtk_selection_model_set_selection (selection_model, desired, update);
+    }
+
+    return G_SOURCE_REMOVE;
+}
+
+static void
+free_touch_selection_change (gpointer user_data)
+{
+    TouchSelectionChange *change = user_data;
+
+    g_object_unref (change->view);
+    g_hash_table_unref (change->selection);
+    g_object_unref (change->target);
+    g_free (change);
+}
