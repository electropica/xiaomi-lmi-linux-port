+# LMI-ARGS-BEGIN
+argv=sys.argv[1:]
+camera_id=0
+allow_non_rear=False
+rest=[]
+index=0
+while index<len(argv):
+    token=argv[index]
+    if token=='--camera-id' and index+1<len(argv):
