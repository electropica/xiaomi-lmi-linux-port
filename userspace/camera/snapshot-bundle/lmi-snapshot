#!/usr/bin/python3
"""Snapshot-owned rear camera lifetime. No capture starts at import or boot."""
import ctypes,fcntl,json,os,selectors,signal,subprocess,time
from pathlib import Path
from gi.repository import Gio

BASE=Path('/usr/local/lib/lmi-camera')
UNIT='lmi-camera-preview.service'

def terminate(p):
    if p is not None and p.poll() is None:
        p.terminate()
        try:p.wait(timeout=8)
        except subprocess.TimeoutExpired:p.kill();p.wait(timeout=3)

def main():
    assert os.getuid()==1000 and len(__import__('sys').argv)==1
    assert os.uname().release=='4.19.325-cip128-st12-perf-ga5b3099017ae-dirty'
    runtime=Path('/run/user/1000/lmi-snapshot');runtime.mkdir(mode=0o700,exist_ok=True)
    assert not runtime.is_symlink() and runtime.stat().st_uid==os.getuid()
    lock=(runtime/'launcher.lock').open('a')
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:
        subprocess.run(['gdbus','call','--session','--dest','org.gnome.Snapshot','--object-path','/org/gnome/Snapshot','--method','org.freedesktop.Application.Activate','{}'],timeout=10)
        return
    start_ticks=Path('/proc/self/stat').read_text().rsplit(')',1)[1].split()[19]
    lease=runtime/'foreground.json'
    def publish(active):
        tmp=runtime/'foreground.next'
        tmp.write_text(json.dumps({'pid':os.getpid(),'start_ticks':start_ticks,'active':active,'updated_ns':time.monotonic_ns()}))
        tmp.chmod(0o600);tmp.replace(lease)
    stopped=False
    def stop(*args):
        nonlocal stopped
        stopped=True
    signal.signal(signal.SIGTERM,stop);signal.signal(signal.SIGINT,stop)
    parent=os.getpid()
    libc=ctypes.CDLL(None,use_errno=True)
    def child_setup():
        # A killed launcher must not leave its producer polling indefinitely.
        if libc.prctl(1,signal.SIGTERM,0,0,0)!=0 or os.getppid()!=parent:os._exit(1)
    focus=producer=app=inhibit=None
    active=False;focused=False;previous=False;started=False
    screen=Gio.DBusProxy.new_for_bus_sync(Gio.BusType.SESSION,
        Gio.DBusProxyFlags.DO_NOT_AUTO_START,None,'org.gnome.ScreenSaver',
        '/org/gnome/ScreenSaver','org.gnome.ScreenSaver',None)
    locked=True;lock_check=0
    try:
        publish(False)
        focus=subprocess.Popen([str(BASE/'snapshot-focus')],stdout=subprocess.PIPE,bufsize=0,preexec_fn=child_setup)
        producer=subprocess.Popen([str(BASE/'native-pipewire-source'),'/run/lmi-camera/live.ppm','0'],preexec_fn=child_setup)
        env=os.environ.copy();env.update({'GSK_RENDERER':'cairo','GDK_DISABLE':'gl,vulkan,dmabuf','LMI_SNAPSHOT_TUNING':'1','LD_PRELOAD':str(BASE/'lmi-snapshot-tuning.so')})
        app=subprocess.Popen(['/usr/bin/snapshot'],env=env,preexec_fn=child_setup)
        selector=selectors.DefaultSelector();selector.register(focus.stdout,selectors.EVENT_READ)
        last=time.monotonic();pending=b''
        while not stopped and app.poll() is None:
            for key,_ in selector.select(.25):
                chunk=os.read(key.fileobj.fileno(),4096)
                if not chunk:raise RuntimeError('Foreground monitor disconnected')
                pending+=chunk
                while b'\n' in pending:
                    value,pending=pending.split(b'\n',1)
                    assert value in (b'0',b'1')
                    focused=value==b'1'
            if focus.poll() is not None or producer.poll() is not None:raise RuntimeError('Camera adapter exited')
            now=time.monotonic()
            if now-lock_check>=1:
                try:locked=bool(screen.call_sync('GetActive',None,Gio.DBusCallFlags.NO_AUTO_START,1500,None).unpack()[0])
                except Exception:locked=True
                lock_check=time.monotonic()
            active=focused and not locked
            if now-last>=.5 or active!=previous:
                publish(active);last=now
            if active and not previous:
                os.kill(producer.pid,signal.SIGCONT)
                subprocess.run(['systemctl','start',UNIT],check=True,timeout=15)
                started=True
                inhibit=subprocess.Popen(['systemd-inhibit','--what=idle:sleep','--mode=block','--why=Foreground camera','sleep','infinity'],preexec_fn=child_setup)
            elif not active and previous:
                subprocess.run(['systemctl','stop',UNIT],check=True,timeout=18)
                started=False;terminate(inhibit);inhibit=None
                os.kill(producer.pid,signal.SIGSTOP)
            previous=active
    finally:
        try:
            publish(False)
            subprocess.run(['systemctl','stop',UNIT],timeout=18)
        finally:
            if producer is not None and producer.poll() is None:
                try:os.kill(producer.pid,signal.SIGCONT)
                except ProcessLookupError:pass
            for p in [app,inhibit,producer,focus]:
                try:terminate(p)
                except (OSError,subprocess.TimeoutExpired):pass
            lease.unlink(missing_ok=True)

if __name__=='__main__':main()
