#!/bin/sh
set -eu

runtime=/run/weston-post-clear
fifo=$runtime/modetest-input
modetest_log=/var/log/weston-post-clear-modetest.log
postclear_log=/var/log/weston-post-clear-state.log
seat_socket=/run/seatd.sock
seat_pid=$runtime/seatd.pid
seat_log=/var/log/weston-post-clear-seatd.log
weston_log=/var/log/weston-post-clear.log
modetest=/usr/local/libexec/d114-modetest

mkdir -p "$runtime"
chown root:root "$runtime"
chmod 0700 "$runtime"
rm -f "$fifo" "$seat_socket" "$seat_pid"
mkfifo "$fifo"

# Exact D114 continuous-splash takeover: hold the atomic state for three
# seconds, then close the FIFO so modetest exits and releases CRTC 129/plane 58.
tail -f /dev/null >"$fifo" &
feeder_pid=$!
"$modetest" -a -s '29@129:#0@XR24' -P '58@129:1080x2400@XR24' \
	<"$fifo" >"$modetest_log" 2>&1 &
modetest_pid=$!
sleep 3
kill "$feeder_pid" 2>/dev/null || true
wait "$feeder_pid" 2>/dev/null || true
if ! wait "$modetest_pid"; then
	echo 'post_clear_status=modetest-failed' >>"$modetest_log"
	exit 1
fi

"$modetest" -p >"$postclear_log" 2>&1
grep -Eq '^129[[:space:]]+0[[:space:]]+\(0,0\)[[:space:]]+\(0x0\)' "$postclear_log"
grep -Eq '^58[[:space:]]+0[[:space:]]+0[[:space:]]' "$postclear_log"
[ "$(cat /sys/class/drm/card0-DSI-1/status 2>/dev/null)" = connected ]
echo 'post_clear_status=crtc129-plane58-cleared-dsi-connected' >>"$postclear_log"

SEATD_VTBOUND=0 /usr/bin/seatd -u root -g root -l info \
	>"$seat_log" 2>&1 &
printf '%s\n' "$!" >"$seat_pid"

i=0
while [ ! -S "$seat_socket" ] && [ "$i" -lt 100 ]; do
	sleep 0.1
	i=$((i + 1))
done
[ -S "$seat_socket" ]

export HOME=/root USER=root LOGNAME=root
export XDG_RUNTIME_DIR="$runtime"
export XDG_SESSION_TYPE=wayland
export WAYLAND_DISPLAY=wayland-d-repro-weston-post-clear
export LIBSEAT_BACKEND=seatd
export SEATD_SOCK="$seat_socket"

exec /usr/bin/weston \
	--socket="$WAYLAND_DISPLAY" \
	--backend=drm-backend.so \
	--drm-device=card0 \
	--renderer=pixman \
	--shell=kiosk-shell.so \
	--config=/etc/weston-post-clear/weston.ini \
	--idle-time=0 \
	--logger-scopes=log,drm-backend \
	--log="$weston_log"
