# Isolated Weston 14 CRTC-129 diagnostic variant; no binary sources are tracked.
pkgname=weston14-lmi
pkgver=14.0.2
pkgrel=1
pkgdesc="Isolated Weston 14 DRM/Pixman/kiosk stack preferring Xiaomi lmi CRTC 129"
url="https://wayland.freedesktop.org/"
arch="aarch64"
license="MIT"
depends="xkeyboard-config"
makedepends="cairo-dev eudev-dev libdisplay-info-dev libdrm-dev libevdev-dev libinput-dev libpng-dev libseat-dev libxkbcommon-dev meson pixman-dev samurai wayland-dev wayland-protocols"
options="!check !pmb:crossdirect !fhs"
ldpath="/opt/weston14-lmi/lib:/opt/weston14-lmi/lib/weston"
source="weston-14.0.2.tar.xz libdisplay-info-0.3.patch prefer-dsi-crtc-129.patch weston-lmi.ini"
builddir="$srcdir/weston-14.0.2"

prepare() { default_prepare; git init -q .; }

build() {
	abuild-meson --prefix=/opt/weston14-lmi --libdir=lib --libexecdir=libexec \
		--buildtype=release -Db_ndebug=true -Db_lto=true \
		-Dbackend-drm=true -Dbackend-default=drm -Dbackend-drm-screencast-vaapi=false \
		-Dbackend-headless=false -Dbackend-pipewire=false -Dbackend-rdp=false \
		-Dbackend-vnc=false -Dbackend-wayland=false -Dbackend-x11=false \
		-Drenderer-gl=false -Dxwayland=false -Dsystemd=false -Dremoting=false \
		-Dpipewire=false -Dscreenshare=false -Dshell-desktop=false \
		-Dshell-fullscreen=false -Dshell-ivi=false -Dshell-kiosk=true \
		-Dcolor-management-lcms=false -Dimage-jpeg=false -Dimage-webp=false \
		-Dtools= -Ddemo-clients=false -Dsimple-clients= -Dresize-pool=false \
		-Dwcap-decode=false -Dtests=false -Dtest-junit-xml=false -Ddoc=false build
	meson compile -C build
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C build
	rm -rf "$pkgdir/opt/weston14-lmi/include" "$pkgdir/opt/weston14-lmi/lib/pkgconfig" \
		"$pkgdir/opt/weston14-lmi/share/man" "$pkgdir/opt/weston14-lmi/share/pkgconfig" \
		"$pkgdir/usr/share/man"
	install -Dm644 "$srcdir/weston-lmi.ini" "$pkgdir/opt/weston14-lmi/etc/weston.ini"
}

