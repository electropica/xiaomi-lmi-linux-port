[Unit]
Description=Release the lmi continuous-splash KMS state
Requires=dev-dri-card0.device
After=systemd-udevd.service dev-dri-card0.device
Before=seatd.service weston-m0.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lmi-splash-release
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
