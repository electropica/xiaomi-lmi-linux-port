+/* Opt-in shortened grace must not accept an obsolete asynchronous FD. */
+typedef struct {
+        GsdPowerManager *manager;
+        guint64 generation;
+} LmiSuspendInhibitRequest;
+
+static gboolean
+lmi_guard_inhibitor_reply (void)
+{
+        return g_strcmp0 (g_getenv ("LMI_GSD_QUIET_GAUGE_RESUME"), "1") == 0 &&
+               lmi_quiet_grace_seconds (TRUE) < POWER_UP_TIME_ON_AC;
+}
+
+static void
+lmi_inhibit_suspend_done (GObject *source,
+                          GAsyncResult *result,
+                          gpointer user_data)
+{
+        LmiSuspendInhibitRequest *request = user_data;
+        GsdPowerManager *manager = request->manager;
+        g_autoptr (GUnixFDList) fd_list = NULL;
+        g_autoptr (GVariant) reply = NULL;
+        g_autoptr (GError) error = NULL;
+        gint index;
+        gint fd = -1;
+        gboolean current;
+
+        reply = g_dbus_proxy_call_with_unix_fd_list_finish (
+                G_DBUS_PROXY (source), &fd_list, result, &error);
+        if (reply != NULL) {
+                g_variant_get (reply, "(h)", &index);
+                fd = g_unix_fd_list_get (fd_list, index, &error);
+        }
+        current = request->generation == manager->lmi_inhibit_generation &&
+                  manager->inhibit_suspend_taken;
+        if (!current) {
+                if (fd >= 0)
+                        close (fd);
+        } else if (fd < 0) {
+                manager->inhibit_suspend_taken = FALSE;
+                g_warning ("Quiet-grace suspend inhibitor request failed: %s",
+                           error ? error->message : "no file descriptor");
+        } else {
+                manager->inhibit_suspend_fd = fd;
+        }
+        g_object_unref (manager);
+        g_free (request);
+}
 /* We take a delay inhibitor here, which causes logind to send a
  * PrepareForSleep signal, which gives us a chance to lock the screen
  * and do some other preparations.
@@ -2759,6 +2829,18 @@ inhibit_suspend (GsdPowerManager *manager)
         }
         g_debug ("Adding suspend delay inhibitor");
         manager->inhibit_suspend_taken = TRUE;
+        if (lmi_guard_inhibitor_reply ()) {
+                LmiSuspendInhibitRequest *request = g_new0 (LmiSuspendInhibitRequest, 1);
+                request->manager = g_object_ref (manager);
+                request->generation = ++manager->lmi_inhibit_generation;
+                g_dbus_proxy_call_with_unix_fd_list (
+                        manager->logind_proxy, "Inhibit",
+                        g_variant_new ("(ssss)", "sleep", g_get_user_name (),
+                                       "GNOME needs to lock the screen", "delay"),
+                        0, G_MAXINT, NULL, NULL,
+                        lmi_inhibit_suspend_done, request);
+                return;
+        }
         g_dbus_proxy_call_with_unix_fd_list (manager->logind_proxy,
                                              "Inhibit",
                                              g_variant_new ("(ssss)",
@@ -2777,6 +2859,11 @@ inhibit_suspend (GsdPowerManager *manager)
 static void
 uninhibit_suspend (GsdPowerManager *manager)
 {
+        if (manager->lmi_inhibit_generation != 0) {
+                /* Invalidate pending replies before an early no-FD return. */
+                manager->lmi_inhibit_generation++;
