+static guint
+lmi_quiet_grace_seconds (gboolean quiet)
+{
+        const gchar *value;
+        gchar *end = NULL;
+        guint64 seconds;
+
+        if (!quiet)
+                return POWER_UP_TIME_ON_AC;
+        value = g_getenv ("LMI_GSD_QUIET_GAUGE_GRACE_SECONDS");
+        if (!value || !*value)
+                return POWER_UP_TIME_ON_AC;
+        /* Accept only decimal integers: no signs, whitespace or suffixes. */
+        for (const gchar *p = value; *p; p++)
+                if (!g_ascii_isdigit (*p))
+                        return POWER_UP_TIME_ON_AC;
+        seconds = g_ascii_strtoull (value, &end, 10);
+        if (!end || *end || seconds < 2 || seconds > POWER_UP_TIME_ON_AC)
+                return POWER_UP_TIME_ON_AC;
+        return (guint) seconds;
+}
