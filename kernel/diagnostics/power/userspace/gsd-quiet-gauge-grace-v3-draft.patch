+        }
         if (manager->inhibit_suspend_fd == -1) {
                 g_debug ("no suspend delay inhibitor");
                 return;
@@ -2787,6 +2874,21 @@ uninhibit_suspend (GsdPowerManager *manager)
         manager->inhibit_suspend_taken = FALSE;
 }
 
+static void
+lmi_shutdown_suspend_inhibitor (GsdPowerManager *manager)
+{
+        if (manager->lmi_inhibit_generation != 0) {
+                /* Replies after shutdown must not install a new descriptor. */
+                manager->lmi_inhibit_generation++;
+                manager->inhibit_suspend_taken = FALSE;
+        }
+        if (manager->inhibit_suspend_fd != -1) {
+                close (manager->inhibit_suspend_fd);
+                manager->inhibit_suspend_fd = -1;
+                manager->inhibit_suspend_taken = FALSE;
+        }
+}
