+/*
+ * The state of the end of the charge, as the hardware reports it.
+ *
+ * The vendor fuel gauge decides that the battery is full from the state of
+ * the charger, not from the counter of the gauge alone: the "report_full"
+ * band of CAF fg_get_msoc promotes the codes just below the full code to
+ * 100 % when the charger reports that the charge is done.  That state is
+ * CHG_STATUS_1 of the charger block (BATTERY_CHARGER_STATUS_1), whose bits
+ * [2:0] hold the charge state; TERMINATE means the hardware ended the
+ * charge.
+ *
+ * The charger driver of this board is bound to the fuel gauge, so the state
+ * is published here for the gauge to read.
+ */
+static int smb5_get_prop_charge_done(struct smb5_chip *chip, int *val)
+{
+	unsigned char stat[2];
+	int rc;
+
+	rc = regmap_bulk_read(chip->regmap,
+			      chip->base + BATTERY_CHARGER_STATUS_1, &stat, 2);
+	if (rc < 0) {
+		dev_err(chip->dev, "Failed to read charging status ret=%d\n",
+			rc);
+		return rc;
+	}
+
+	*val = ((stat[0] & BATTERY_CHARGER_STATUS_MASK) == TERMINATE_CHARGE);
+
+	return 0;
+}
