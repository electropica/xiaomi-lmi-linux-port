From: electropica <552299+electropica@users.noreply.github.com>
Subject: [PATCH] lmi: let the PM8150B charger follow the USB source

The charger of this board runs on the ROM defaults: the input current
limit stays at the 500 mA of 0x1370 while the USB-C connector
advertises 5000 mV / 3000 mA. The handset therefore draws its system
load from the battery as soon as the load passes 500 mA, which is
what the 2026-10-28 and 2026-11-01 captures show: the phone reaches
99 % then slides down to 96 % with the cable plugged in.

The upstream community driver cannot be used as it is on this tree:

- it programs the float voltage with the 7.5 mV scale of another
  PMIC, which would command 4.90 V for this cell;
- it asks for an interrupt named "usbin-plugin" while the board
  names it "usb-plugin", so it would never probe;
- it writes the Type-C block (0x1544 and neighbours), which the
  qcom,pm8150b-typec driver of this board owns, and the Type-C
  attach and detach detection of the port depends on it;
- it selects the input current limit from the D+/D- detection,
  which says nothing about a Type-C source;
- it enables a SOC based re-charge threshold, but the community fuel
  gauge never publishes its SOC to the charger.

This patch keeps the driver and corrects those points: the input
current limit follows the capability the source advertises on CC,
capped at the 3000 mA of the connector, the automatic re-charge stays
driven by the battery voltage, the Type-C block is left alone, the
float voltage keeps the value the ROM programmed, and the input is
never suspended on a collapse of the input voltage.

Signed-off-by: electropica <552299+electropica@users.noreply.github.com>
---
--- a/drivers/power/supply/qcom_pm8150b_charger.c
+++ b/drivers/power/supply/qcom_pm8150b_charger.c
@@ -75,6 +75,14 @@
 
 #define FLOAT_VOLTAGE_CFG			0x70
 #define FLOAT_VOLTAGE_SETTING_MASK		GENMASK(7, 0)
+/*
+ * The PM8150B encodes the float voltage as 3.6 V + code * 10 mV,
+ * 4.79 V maximum (CAF qpnp-smb5.c, smb5_pm8150b_params). The upstream
+ * community driver used a 7.5 mV step over a 3487.5 mV base, which is
+ * the scale of another PMIC: with it, the 4460 mV design voltage of
+ * this cell would have been programmed as 4.90 V. Nothing writes this
+ * register in this driver, see smb5_probe().
+ */
 
 #define CHARGE_RCHG_SOC_THRESHOLD_CFG_REG	0x7D
 #define CHARGE_RCHG_SOC_THRESHOLD_CFG_MASK	GENMASK(7, 0)
@@ -255,6 +263,14 @@
 #define CDP_CURRENT_UA			3000000
 #define DCP_CURRENT_UA			3300000
 #define CURRENT_MAX_UA			DCP_CURRENT_UA
+/*
+ * Input current ceiling of this board: the USB-C connector advertises a
+ * 5000 mV / 3000 mA source PDO and the port TCPM negotiated 5 V / 3 A
+ * (the tcpm event log of the port). The limit is never raised above it.
+ */
+#define USB_ICL_MAX_UA			3000000
+#define TYPE_C_RP_1P5_CURRENT_UA	1500000
+#define TYPE_C_RP_DEFAULT_CURRENT_UA	500000
 
 /* pmi8150b registers represent current in increments of 1/40th of an amp */
 #define CURRENT_SCALE_FACTOR		50000
@@ -504,9 +520,37 @@
 				  enable ? CHARGING_ENABLE_CMD_BIT : 0);
 }
 
+/*
+ * Current the attached source can deliver, as advertised on CC by the
+ * Type-C block of the same PMIC: Rp 3.0 A, Rp 1.5 A or the USB 2.0
+ * default. Returns -ENODATA when no source capability is visible.
+ */
+static int smb5_get_typec_input_current(struct smb5_chip *chip,
+					 unsigned int *ua)
+{
+	unsigned int status;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + TYPE_C_SNK_STATUS,
+			   &status);
+	if (rc < 0)
+		return rc;
+
+	if (status & SNK_RP_3P0_BIT)
+		*ua = USB_ICL_MAX_UA;
+	else if (status & SNK_RP_1P5_BIT)
+		*ua = TYPE_C_RP_1P5_CURRENT_UA;
+	else if (status & SNK_RP_STD_BIT)
+		*ua = TYPE_C_RP_DEFAULT_CURRENT_UA;
+	else
+		return -ENODATA;
+
+	return 0;
+}
+
 static void smb5_status_change_work(struct work_struct *work)
 {
-	unsigned int charger_type, current_ua;
+	unsigned int charger_type, current_ua = 0;
 	int usb_online = 0;
 	int count, rc;
 	struct smb5_chip *chip;
@@ -517,47 +561,68 @@
 	if (!usb_online)
 		return;
 
-	for (count = 0; count < 3; count++) {
-		dev_dbg(chip->dev, "get charger type retry %d\n", count);
-		rc = smb5_apsd_get_charger_type(chip, &charger_type);
-		if (rc != -EAGAIN)
+	/*
+	 * The input current limit follows the capability the source
+	 * advertises on CC. This board negotiates its power delivery with
+	 * the port TCPM, so the Rp seen by the PMIC Type-C block is the
+	 * only contract the kernel can see: the D+/D- detection of the
+	 * charger block says nothing about a Type-C source and used to
+	 * leave the limit at the 500 mA ROM default.
+	 */
+	rc = smb5_get_typec_input_current(chip, &current_ua);
+	if (rc) {
+		/*
+		 * No Type-C source: fall back to the D+/D- detection for
+		 * USB-A style sources.
+		 */
+		for (count = 0; count < 3; count++) {
+			dev_dbg(chip->dev, "get charger type retry %d\n", count);
+			rc = smb5_apsd_get_charger_type(chip, &charger_type);
+			if (rc != -EAGAIN)
+				break;
+			msleep(100);
+		}
+
+		if (rc < 0) {
+			/*
+			 * Unknown source: keep the programmed limit and look again
+			 * later instead of guessing a higher one.
+			 */
+			dev_dbg(chip->dev,
+				 "no source capability, keeping the input current limit\n");
+			if (rc == -EAGAIN)
+				schedule_delayed_work(&chip->status_change_work,
+					msecs_to_jiffies(1000));
+			return;
+		}
+
+		switch (charger_type) {
+		case POWER_SUPPLY_USB_TYPE_CDP:
+			current_ua = CDP_CURRENT_UA;
+			break;
+		case POWER_SUPPLY_USB_TYPE_DCP:
+			current_ua = DCP_CURRENT_UA;
 			break;
-		msleep(100);
+		case POWER_SUPPLY_USB_TYPE_SDP:
+		default:
+			current_ua = SDP_CURRENT_UA;
+			break;
+		}
 	}
 
-	if (rc < 0 && rc != -EAGAIN) {
-		dev_err(chip->dev, "get charger type failed: %d\n", rc);
-		return;
-	}
+	/* Never above the current the connector advertises. */
+	if (current_ua > USB_ICL_MAX_UA)
+		current_ua = USB_ICL_MAX_UA;
 
-	if (rc < 0) {
-		/*
-		 * APSD not done yet — set a conservative DCP interim limit so
