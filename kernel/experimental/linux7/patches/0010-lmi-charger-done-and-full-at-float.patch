+/*
+ * Remember whether the charge of this cycle reached the taper phase.
+ *
+ * The taper phase is the one where the charger reduces the current because
+ * the cell has reached the float voltage.  A charge that never entered it
+ * stopped before the float, which is what a too small input limit causes:
+ * such a charge is not a finished charge.
+ */
+static void smb5_track_charge_state(struct smb5_chip *chip, int state)
+{
+	switch (state) {
+	case TRICKLE_CHARGE:
+	case PRE_CHARGE:
+	case FAST_CHARGE:
+	case FULLON_CHARGE:
+		/* A new charge cycle starts here. */
+		chip->reached_taper = false;
+		break;
+	case TAPER_CHARGE:
+		chip->reached_taper = true;
+		break;
+	default:
+		break;
+	}
+}
+
