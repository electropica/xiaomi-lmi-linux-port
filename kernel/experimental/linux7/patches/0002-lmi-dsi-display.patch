Subject: [PATCH 2/3] lmi: add the DSI display path to the observer DTS

Enable the upstream SM8250 display subsystem, the DSI controller, the
4-lane DSI output, the 7 nm PHY and the lmi AMOLED panel node, and
declare the three panel rails that the observer tree did not carry
(vddio 1.88 V on PM8150 LDO14, vci 3.0 V on PM8150L LDO10 and the
DSI controller rail 1.2 V on PM8150 LDO9).

Generated by kernel/experimental/linux7/tools/regen-display-patches.py.
---
--- a/arch/arm64/boot/dts/qcom/sm8250-xiaomi-lmi-observer.dts
+++ b/arch/arm64/boot/dts/qcom/sm8250-xiaomi-lmi-observer.dts
@@ -297,6 +297,51 @@
 			regulator-max-microvolt = <1800000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
 		};
+
+		/*
+		 * Display rails, lmi display1 variant.
+		 *
+		 * vreg_l9a_1p2: DSI controller rail (vdda). PM8150 LDO9 at 1.2 V,
+		 * same node as the community lmi board (vreg_l9a_1p2).
+		 */
+		vreg_l9a_1p2: ldo9 {
+			regulator-name = "vreg_l9a_1p2";
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1200000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+
+		/*
+		 * vreg_l14a_1p88: panel IO rail (vddio). PM8150 LDO14.
+		 * The vendor kona-sde-display.dtsi asks for 1880000 uV (unique) and
+		 * the upstream SM8250 boards declare 1.88 V for the same LDO, while
+		 * the community lmi board declares 1.8-1.88 V. The vendor value is
+		 * used because it is the one established for this handset.
+		 */
+		vreg_l14a_1p88: ldo14 {
+			regulator-name = "vreg_l14a_1p88";
+			regulator-min-microvolt = <1880000>;
+			regulator-max-microvolt = <1880000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
+	};
+
+	/*
+	 * vreg_l10c_3p0: panel VCI rail. PM8150L LDO10 at 3.0 V.
+	 * The vendor kona-sde-display.dtsi asks for 3000000 uV (unique); the
+	 * community lmi board declares the same rail inside the pm8150l
+	 * regulator list.
+	 */
+	regulators-1 {
+		compatible = "qcom,pm8150l-rpmh-regulators";
+		qcom,pmic-id = "c";
+
+		vreg_l10c_3p0: ldo10 {
+			regulator-name = "vreg_l10c_3p0";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+		};
 	};
 };
 
@@ -306,7 +351,56 @@
  * first experiment. No remoteproc is started either, so no firmware is loaded.
  */
 &mdss {
-	status = "disabled";
+	status = "okay";
+};
+
+/*
+ * DSI display path for the lmi AMOLED panel (display1 variant).
+ *
+ * Upstream sm8250.dtsi provides mdss (display-subsystem@ae00000),
+ * mdss_mdp (display-controller@ae01000), mdss_dsi0 (dsi@ae94000) and
+ * mdss_dsi0_phy (phy@ae94400, "qcom,dsi-phy-7nm"). Both mdss and mdss_mdp
+ * carry no status property upstream, so enabling &mdss brings the display
+ * controller up with it; the observer tree had deliberately disabled it.
+ *
+ * The DSI controller rail is PM8150 LDO9 (1.2 V). The PHY rail is PM8150
+ * LDO5, the same physical rail the USB2 PHY already uses in this tree
+ * (declared as vreg_l5a_0p88 above): the community lmi board names it
+ * vreg_l5a_0p875, the upstream SM8250 board convention is 880 mV, and the
+ * 7 nm PHY driver requests "vdds" without a voltage constraint, so the
+ * existing declaration is reused unchanged.
+ *
+ * The panel node carries the vendor rails (vddio 1.88 V, vci 3.0 V) and the
+ * lmi reset line (tlmm 46, active low), as in the community lmi board file.
+ */
+&mdss_dsi0 {
+	vdda-supply = <&vreg_l9a_1p2>;
+	status = "okay";
+
+	panel: panel@0 {
+		compatible = "xiaomi,lmi-ams667uu01";
+		reg = <0>;
+
+		vddio-supply = <&vreg_l14a_1p88>;
+		vci-supply = <&vreg_l10c_3p0>;
+		reset-gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	remote-endpoint = <&panel_in>;
+	data-lanes = <0 1 2 3>;
+};
+
+&mdss_dsi0_phy {
+	vdds-supply = <&vreg_l5a_0p88>;
+	status = "okay";
 };
 
