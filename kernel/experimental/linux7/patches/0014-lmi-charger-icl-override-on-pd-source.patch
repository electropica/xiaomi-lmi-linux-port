-		if (smb5_source_detected_as_sdp(chip, &is_sdp) || is_sdp)
+		if (!smb5_get_pd_source_current(chip, &pd_ua)) {
+			/*
+			 * The source is a PD source: the current it
+			 * negotiated is its real capability, and the
+			 * detection of the charger block says nothing
+			 * about it because the D+/D- lines are not used
+			 * on such a link.
+			 */
+			if (pd_ua > current_ua)
+				current_ua = pd_ua;
+			if (current_ua > USB_ICL_MAX_UA)
